# Copiez en `.env` et renseignez. Chargé automatiquement au démarrage via
# python-dotenv (dégrade silencieusement si dotenv absent, ex. en CI).

# Neon Postgres — connection string directe (port 5432). Le `?sslmode=require`
# est obligatoire : Neon refuse les connexions non chiffrées.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
